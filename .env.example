# Daisu environment configuration — copy to `.env.local` and fill in.
# Every value is OPTIONAL: with none set, the app runs in guest mode exactly
# as it does today (no accounts, no crashes, no console noise).

# --- Multiplayer / room servers -------------------------------------------
# Public multiplayer room server (WebSocket + HTTP).
# VITE_MULTIPLAYER_SERVER_URL=ws://localhost:8080
# VITE_MULTIPLAYER_SERVER_HTTP_URL=http://localhost:8080

# Local loopback solo room server (separate from the public server on purpose).
# VITE_LOCAL_ROOM_SERVER_URL=ws://127.0.0.1:8080
# VITE_LOCAL_ROOM_SERVER_HTTP_URL=http://127.0.0.1:8080

# --- Supabase accounts & profiles (issue #81, ADR 006) --------------------
# Enables Discord OAuth sign-in and cloud profiles. Leave BOTH unset to keep
# the app in guest-only mode. The anon key is public-safe (protected by RLS);
# never put the service-role key or JWT secret here.
# Project id `nksxdfcjabgbxeefwkdc` is public-safe.
# VITE_SUPABASE_URL=https://nksxdfcjabgbxeefwkdc.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-sb_publishable-key
# VITE_SUPABASE_ANON_KEY=legacy-public-anon-key

# --- Payments / Xsolla sandbox checkout (issue #153, ADR 006) -------------
# Gates the ENTIRE client payments surface (buy button, /checkout/return route,
# cold-relaunch reconciliation banner) and the Pay Station SDK. Leave UNSET to
# keep payments fully dark: nothing payment-related renders and the SDK is never
# code-loaded. Set to `true` to enable the sandbox checkout client. Go-live is a
# single env switch, not a code change. Real payments stay blocked on the Xsolla
# merchant agreement; sandbox mode is enforced server-side (XSOLLA_SANDBOX), not
# by trusting the client. Recognized truthy values: true | 1 | on | yes.
# VITE_PAYMENTS_ENABLED=true

# --- Discord room bot (issues #84 / #246, SERVER-side only) ---------------
# Set on the ROOM SERVER (server/), not the frontend. With the bot token and
# APP_BASE_URL present, a room's HOST can post their room to a Discord server
# they belong to (and the bot is installed in) from the share sheet; the embed
# live-updates and is archived — never deleted — when the room closes. Leave
# either unset to keep the bot OFF (server runs unchanged). The bot token is a
# SECRET — never commit it; supply via env/secret storage. See
# docs/guides/discord.md for the one-time Discord app/bot setup checklist.
# DISCORD_BOT_TOKEN=your-bot-token
# APP_BASE_URL=https://your-frontend-domain   # used to build /room/<id> join links
#
# OPTIONAL, legacy (#84): when set, every PUBLIC room is also mirrored into this
# one operator-configured channel (deleted on close). Unset for the host-posting
# model — no guild ever receives a post without an explicit host action.
# DISCORD_CHANNEL_ID=123456789012345678

# --- Discord bot invite link (issue #246, FRONTEND) -----------------------
# Shown as "Add the Dicesuki bot to your server" in the room share sheet's
# Post-to-Discord empty state, for hosts whose servers don't have the bot yet.
# This is a PUBLIC self-serve OAuth install URL (client id + scopes/permissions),
# not a secret. Leave UNSET to hide the link entirely — the picker still works
# for hosts who already share a server with the bot. Copy it from the Discord
# developer portal (OAuth2 → URL Generator, scope `bot` — the bot registers no
# slash commands, so `applications.commands` is not needed).
#
# permissions=309237664768 is VIEW_CHANNEL | SEND_MESSAGES | EMBED_LINKS |
# CREATE_PUBLIC_THREADS | SEND_MESSAGES_IN_THREADS — see INVITE_PERMISSIONS in
# server/src/discord_api.rs. Permissions are granted at INSTALL time, so a guild
# that installed with a narrower link keeps working but silently gets embed-only
# adverts with no session thread (#255), and only a re-invite fixes it. The
# previous value here (18432) was also missing VIEW_CHANNEL, which the bot has
# required for posting targets since #246.
# VITE_DISCORD_BOT_INVITE_URL=https://discord.com/oauth2/authorize?client_id=YOUR_APP_ID&scope=bot&permissions=309237664768
